<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reserva de Asientos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Documento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Documento de identidad"/>

    <EditText
        android:id="@+id/txtDocument"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese documento"
        android:inputType="number"
        android:layout_marginBottom="15dp"/>

    <!-- Cantidad de asientos -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Número de asientos"/>

    <EditText
        android:id="@+id/txtSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese cantidad"
        android:inputType="number"
        android:layout_marginBottom="20dp"/>

    <!-- Botón reservar -->
    <Button
        android:id="@+id/btnReserve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservar"/>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#CCCCCC"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>

    <!-- Título listado -->
    <TextView
        android:id="@+id/txtListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservas Registradas"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"/>

    <!-- Listado -->
    <ListView
        android:id="@+id/listReservations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>

